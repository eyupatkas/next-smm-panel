# PostgreSQL database owned by your installation; no production data is included.
DATABASE_URL="postgresql://smm:change-me@localhost:5432/smmpanel?schema=public"

# Generate separate values with: openssl rand -hex 32
AUTH_SECRET=""
CRON_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Background jobs stay disabled until providers and payments are configured.
DISABLE_EMBEDDED_SCHEDULER="1"
ENABLE_EMBEDDED_SCHEDULER_DEV="0"
PROVIDER_SYNC_INTERVAL_MS="60000"
PROVIDER_SYNC_BATCH_LIMIT="25"
PROVIDER_API_TIMEOUT_MS="20000"

# Optional Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional AI integrations (can also be configured in the admin panel)
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""

# Optional Shopier integration
SHOPIER_CLIENT_ID=""
SHOPIER_CLIENT_SECRET=""
SHOPIER_WEBHOOK_TOKEN=""

# Used only by pnpm admin:reset. Set a unique password of at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
